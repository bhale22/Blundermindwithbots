# ── Signing keys — NEVER commit ─────────────────────────────────────────────
# Losing these is bad; publishing them is worse. With Play App Signing an
# upload key can be reset, but treat both as secrets regardless.
*.keystore
*.jks
keystore.properties
local.properties

# ── Build output ────────────────────────────────────────────────────────────
# An .aab is 50MB+ and is regenerated by `bubblewrap build` every time.
build/
app/build/
.gradle/
*.apk
*.aab
*.idsig
output-metadata.json

# ── Tooling ─────────────────────────────────────────────────────────────────
.idea/
*.iml
.DS_Store
node_modules/
