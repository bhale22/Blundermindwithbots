# Dependencies
node_modules/

# Environment variables
.env
.env.local
.env.production

# OS files
.DS_Store
Thumbs.db

# Editor files
.vscode/
.idea/

# Logs
*.log
npm-debug.log*

# Build artifact — assembled from src/ by build.js / server.js
blundermind.html

# Model-download tally when no STATS_DIR volume is configured (server.js).
# On Railway this path is ephemeral anyway; locally it is just scratch.
.data/

# ── Android signing keys — NEVER commit ─────────────────────────────────────
# android/android.keystore signs every release. Publishing it lets anyone ship
# an update as you; losing it is recoverable only via Play App Signing.
*.keystore
*.jks
keystore.properties
local.properties

# ── Android build output ────────────────────────────────────────────────────
# Regenerated by `bubblewrap build`; an .aab is 50MB+.
android/build/
android/app/build/
android/.gradle/
*.apk
*.aab
*.idsig
output-metadata.json

# ── Personal scratch folder ────────────────────────────────────────────────
# Lives on the Desktop. A copy landed here once and was committed by accident,
# publishing 60-odd private files plus an API token. It never belongs in git.
BlunderStash/
